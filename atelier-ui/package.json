{
  "name": "atelier-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "type-check": "vue-tsc --build",
    "serve": "vite preview",
    "format": "prettier --write --experimental-cli src/ tests/",
    "test": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.5",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.1.0",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.1.0",
    "prettier": "3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  }
}
