{
  "name": "atelier-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "type-check": "vue-tsc --build",
    "serve": "vite preview",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.8",
    "highlight.js": "^11.10.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.21",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^7.0.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "rollup-plugin-visualizer": "^7.1.3",
    "sass-embedded": "^1.108.1",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
